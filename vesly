STRIP=re.compile(r"\x1b\[[0-9;]*m")

def color(rgb):
    return "\033[38;2;%d;%d;%dm" % rgb if USE_COLOR else ""
def reset():
    return "\033[0m" if USE_COLOR else ""
def p(text, rgb):
    return color(rgb)+str(text)+reset() if USE_COLOR else str(text)
def visible(s):
    return len(STRIP.sub("",s))
def padded(s,n):
    return s+" "*max(0,n-visible(s))
def short(s,n=37):
    s=str(s)
    return s if len(s)<=n else s[:n-1]+"…"
def grad(t):
    t=max(0,min(1,t))
    return tuple(round(x+(y-x)*t) for x,y in zip(PURPLE_DARK,PURPLE_LIGHT))
def call(*cmd,timeout=2):
    try:
        return subprocess.run(cmd,capture_output=True,text=True,timeout=timeout,check=False).stdout.strip()
    except (OSError,subprocess.TimeoutExpired):
        return ""
def read(path):
    try:
        with open(path,encoding="utf-8",errors="replace") as f: return f.read()
    except OSError: return ""
def sized(n):
    n=float(n)
    for unit in ("B","KiB","MiB","GiB","TiB","PiB"):
        if abs(n)<1024 or unit=="PiB":
            return ("%0.0f" if unit=="B" else "%0.2f")%n+" "+unit
        n/=1024
    return "n/a"
def info_mem():
    result={}
    for row in read("/proc/meminfo").splitlines():
        try:
            key,value=row.split(":",1)
            result[key]=int(value.strip().split()[0])*1024
        except (ValueError,IndexError): pass
    return result
def get_uptime():
    try: seconds=int(float(read("/proc/uptime").split()[0]))
    except (ValueError,IndexError): return "n/a"
    days,rem=divmod(seconds,86400)
    hrs,rem=divmod(rem,3600)
    return (str(days)+"d " if days else "")+f"{hrs:02d}h {rem//60:02d}m"
def measure_cpu():
    def sample():
        try:
            n=[int(x) for x in read("/proc/stat").splitlines()[0].split()[1:]]
            return sum(n),sum(n[3:5])
        except (ValueError,IndexError): return 0,0
    t1,i1=sample()
    time.sleep(.12)
    t2,i2=sample()
    return round(100*(1-(i2-i1)/(t2-t1))) if t2>t1 else 0
def disks():
    rows=[("/","/")]
    root_source=None
    for line in read("/proc/mounts").splitlines():
        x=line.split()
        if len(x)>2 and x[1]=="/": root_source=x[0]
    for line in read("/proc/mounts").splitlines():
        x=line.split()
        if len(x)<3: continue
        src,mount=x[0],x[1].replace("\\040"," ")
        if src.startswith("/dev/") and not src.startswith("/dev/loop") and src!=root_source and mount!="/" and mount.startswith(("/srv","/data","/tank","/home","/mnt","/media","/var/lib/pterodactyl","/var/lib/docker")):
            rows.append((mount,src))
    rows=[rows[0]]+sorted(rows[1:],key=lambda r:(not r[0].startswith(("/srv","/data","/tank","/home","/mnt","/media")),r[0]))
    result=[]
    seen=set()
    for mount,_ in rows:
        try:
            stat=os.stat(mount)
            if stat.st_dev in seen: continue
            usage=shutil.disk_usage(mount)
            if not usage.total: continue
            seen.add(stat.st_dev)
            result.append((mount,usage.used,usage.total))
        except OSError: pass
        if len(result)==3: break
    return result
def net():
    route=call("ip","-4","route","get","1.1.1.1")
    match_ip=re.search(r"\bsrc\s+(\d+\.\d+\.\d+\.\d+)",route)
    match_dev=re.search(r"\bdev\s+(\S+)",route)
    ip=match_ip.group(1) if match_ip else "n/a"
    dev=match_dev.group(1) if match_dev else "n/a"
    if ip=="n/a":
        for line in call("ip","-o","-4","addr","show","scope","global").splitlines():
            if "tailscale" in line.lower(): continue
            a=re.search(r"\binet\s+(\d+\.\d+\.\d+\.\d+)",line)
            if a: ip=a.group(1); break
    ts=call("tailscale","ip","-4",timeout=3)
    return ip,ts.splitlines()[0] if ts else "not connected",dev
def graph(used,total,length=27):
    frac=max(0,min(1,used/total)) if total else 0
    full=round(frac*length)
    bar="".join(p("━",grad(i/max(length-1,1))) if i<full else p("─",GREY) for i in range(length))
    if total<=0:
        return "  "+bar
    return "  "+bar+p("  %d%%"%round(frac*100),AMBER if frac>=.85 else FAINT)
def details():
    host=socket.gethostname()
    pretty=call("hostnamectl","--pretty") or host
    user=getpass.getuser()
    os_data=read("/etc/os-release")
    mo=re.search(r'^PRETTY_NAME="?([^"\n]+)"?$',os_data,re.M)
    distro=mo.group(1) if mo else platform.system()
    cdata=read("/proc/cpuinfo")
    cpu=re.search(r"^model name\s*:\s*(.+)$",cdata,re.M)
    mhz=re.search(r"^cpu MHz\s*:\s*(.+)$",cdata,re.M)
    cpu_name=re.sub(r"\s+"," ",cpu.group(1).replace("(R)","").replace("(TM)","")).strip() if cpu else "n/a"
    clock="%.2f GHz"%(float(mhz.group(1))/1000) if mhz else "n/a"
    mem=info_mem()
    total=mem.get("MemTotal",0)
    used=max(0,total-mem.get("MemAvailable",total))
    swap=mem.get("SwapTotal",0)
    used_swap=max(0,swap-mem.get("SwapFree",swap))
    ip,ts,iface=net()
    package_out=call("dpkg-query","-W",timeout=6)
    try: load=" / ".join("%.2f"%x for x in os.getloadavg())
    except OSError: load="n/a"
    virtual=call("systemd-detect-virt") or "unknown"
    processes=len([x for x in os.listdir("/proc") if x.isdigit()])
    tty=os.environ.get("SSH_TTY") or (os.ttyname(0) if os.isatty(0) else "n/a")
    src=os.environ.get("SSH_CONNECTION","").split()
    peer=src[0] if src else "local session"
    lines=[]
    def row(s=""): lines.append(s)
    def heading(s): row(p(s.upper(),CYAN))
    def val(k,v,shade=WHITE): row(p("  %-13s"%short(k,13),LAV)+p(short(v,35),shade))
    def meter(k,v,n):
        val(k,(sized(v)+" / "+sized(n)) if n else "disabled")
        row(graph(v,n))
    row(p(user+"@"+host,PINK))
    row(p("─"*48,LAV))
    row()
    heading("System")
    val("OS",distro)
    val("Node",pretty)
    val("Kernel",platform.release())
    val("Uptime",get_uptime())
    val("Packages",str(len(package_out.splitlines()))+" (dpkg)" if package_out else "n/a")
    val("Shell",os.path.basename(os.environ.get("SHELL","unknown")))
    val("Terminal",tty)
    row()
    heading("Compute")
    val("CPU",cpu_name)
    val("vCPU",os.cpu_count() or 1)
    val("Clock",clock)
    val("CPU Usage",str(measure_cpu())+"%")
    val("Load Avg",load)
    val("Processes",processes)
    val("Hypervisor",virtual)
    row()
    heading("Resources")
    meter("Memory",used,total)
    meter("Swap",used_swap,swap)
    for path,u,t in disks():
        meter("Disk "+short(path,8),u,t)
    row()
    heading("Network")
    val("Local IP",ip,CYAN)
    val("Tailscale IP",ts,CYAN)
    val("Interface",iface)
    row()
    heading("Session")
    val("Current user",user)
    val("SSH peer",peer)
    val("Sessions",len(call("who").splitlines()))
    val("Locale",os.environ.get("LANG","n/a"))
    val("Timezone",datetime.datetime.now().astimezone().tzname())
    val("System time",datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"))
    row()
    row("  "+"".join(p("━━━",c) for c in (GREY,PURPLE_DARK,(145,85,248),LAV,PURPLE_LIGHT,(192,140,254),PURPLE_DARK,WHITE)))
    return lines,pretty
def render_art(w,h):
    figw=max(map(len,LOGO))
    if figw>w: return [p("Increase terminal width to view ASCII logo.",FAINT)]
    ox=(w-figw)//2
    oy=max(0,(h-len(LOGO))//2)
    rand=random.SystemRandom()
    out=[]
    for y in range(h):
        fy=y-oy
        line=LOGO[fy] if 0<=fy<len(LOGO) else ""
        occupied=[i for i,x in enumerate(line) if x!=" "]
        lo=min(occupied) if occupied else None
        hi=max(occupied) if occupied else None
        chars=[]
        prev=None
        for x in range(w):
            fx=x-ox
            char=line[fx] if 0<=fx<len(line) else " "
            restricted=lo is not None and lo-3<=fx<=hi+3
            rgb=None
            if char!=" ":
                t=(fy/max(1,len(LOGO)-1)+(max(0,fx)/max(1,figw))*.25)/1.25
                rgb=grad(t)
            elif not restricted and rand.random()<(.12 if y%8==0 else .075):
                char=rand.choices([".","*","+"],weights=[80,18,2])[0]
                rgb=FAINT if char=="." else LAV
            if USE_COLOR and prev!=rgb:
                chars.append(color(rgb) if rgb else reset())
                prev=rgb
            chars.append(char)
        out.append("".join(chars)+(reset() if USE_COLOR else ""))
    return out
def notice(pretty,cols):
    n=min(79,max(35,cols-2))
    def line(text=""):
        return p("│ ",LAV)+padded(text,n-2)+p(" │",LAV)
    return [
        p("┌"+"─"*n+"┐",LAV),
        line(p("! SYSTEM ACCESS NOTICE !",PINK)),
        p("├"+"─"*n+"┤",LAV),
        line(),
        line(p("Internal access - Vesly Cloud Labs infrastructure",LAV)),
        line("This machine is maintained by Vesly Cloud Labs."),
        line(),
        line(p("Node: ",CYAN)+short(pretty,65)),
        line(p("Access: ",CYAN)+"authenticated personnel only"),
        line(),
        line("- Experimental services. Predictable consequences."),
        line("- Changes belong in version control, not in memory."),
        line("- Credentials are secrets, not shell arguments."),
        line("- Trust boundaries exist for a reason."),
        line(),
        line(p("Security contact: ",CYAN)+p("security@vesly.dev",PINK)),
        line(),
        p("└"+"─"*n+"┘",LAV),
    ]
def main():
    if sys.stdout.isatty() and not opts.no_clear: sys.stdout.write("\033[2J\033[H")
    cols=shutil.get_terminal_size(fallback=(140,50)).columns
    lines,pretty=details()
    artw=79 if cols>=82 else max(35,cols-2)
    gap=3
    horizontal=cols>=artw+gap+48
    art=render_art(artw,max(len(LOGO)+6,len(lines)) if horizontal else len(LOGO)+6)
    print("\n".join(notice(pretty,cols)))
    if horizontal:
        for i in range(max(len(art),len(lines))):
            left=art[i] if i<len(art) else ""
            right=lines[i] if i<len(lines) else ""
            print(padded(left,artw)+" "*gap+right)
    else:
        print("\n".join(art))
        print()
        print("\n".join(lines))
    print()

def compact_graph(used, total, width=26):
    ratio=max(0.0,min(1.0,used/total)) if total else 0.0
    fill=round(width*ratio)
    chars=[]
    for x in range(width):
        if x<fill:
            chars.append(p("━",grad(x/max(width-1,1))))
        else:
            chars.append(p("─",GREY))
    track="  "+"".join(chars)
    if total<=0:
        return track
    return track+p(" %d%%"%round(ratio*100), AMBER if ratio>=.85 else FAINT)


def compact_info(width):
    hostname=socket.gethostname()
    username=getpass.getuser()
    pretty=call("hostnamectl","--pretty") or hostname
    os_data=read("/etc/os-release")
    os_match=re.search(r'^PRETTY_NAME="?([^"\n]+)"?$',os_data,re.M)
    distro=os_match.group(1) if os_match else platform.system()
    cpu_data=read("/proc/cpuinfo")
    cpu_match=re.search(r"^model name\s*:\s*(.+)$",cpu_data,re.M)
    cpu_name=re.sub(r"\s+"," ",cpu_match.group(1).replace("(R)","").replace("(TM)","")).strip() if cpu_match else "unknown"
    memory=info_mem()
    mem_total=memory.get("MemTotal",0)
    mem_used=max(0,mem_total-memory.get("MemAvailable",mem_total))
    swap_total=memory.get("SwapTotal",0)
    swap_used=max(0,swap_total-memory.get("SwapFree",swap_total))
    ip,tail_ip,dev=net()
    ssh=os.environ.get("SSH_CONNECTION","").split()
    peer=ssh[0] if ssh else "local"
    try:
        loads=os.getloadavg()
    except OSError:
        loads=[0,0,0]
    packages=call("dpkg-query","-W",timeout=5)
    pkg_count=len(packages.splitlines()) if packages else "?"
    now=datetime.datetime.now().astimezone()
    rows=[]
    def value(key, val, rgb=WHITE):
        key_width=10
        rows.append(p(("%-"+str(key_width)+"s")%key,LAV)+p(short(str(val),max(1,width-key_width)),rgb))
    def bar(title,used,total):
        text=(sized(used)+" / "+sized(total)) if total else "disabled"
        value(title,text)
        rows.append(compact_graph(used,total,min(27,max(12,width-9))))
    rows.append(p(short(username+"@"+hostname,width),PINK))
    value("OS",distro)
    value("Node",pretty+"   Up "+get_uptime())
    value("Kernel",platform.release())
    value("CPU",cpu_name)
    value("Compute",f"{os.cpu_count() or 1} vCPU · {measure_cpu()}% · L {loads[0]:.2f}")
    value("Runtime",f"{len([x for x in os.listdir('/proc') if x.isdigit()])} procs · {call('systemd-detect-virt') or 'host'}")
    bar("Memory",mem_used,mem_total)
    bar("Swap",swap_used,swap_total)
    for diskpath,used,total in disks()[:2]:
        bar("Disk "+short(diskpath,5),used,total)
    value("Local IP",ip,CYAN)
    value("Tailscale",tail_ip,CYAN)
    value("Network",dev+" · SSH "+peer)
    value("Packages",str(pkg_count)+" · shell "+os.path.basename(os.environ.get("SHELL","unknown")))
    value("Time",now.strftime("%H:%M:%S")+" "+str(now.tzname()))
    rows.append("  "+"".join(p("━━",c) for c in (GREY,PURPLE_DARK,(145,85,248),LAV,PURPLE_LIGHT,(192,140,254),PURPLE_DARK,WHITE)))
    return rows,pretty



