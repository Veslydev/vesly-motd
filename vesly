def compressed_logo(mode,width,height):
    figure=IMAGE_WIDE_LINES if mode=='half' else IMAGE_NARROW_LINES
    fw=len(figure[0])
    ox=max(0,(width-fw)//2)
    oy=max(0,(height-len(figure))//2)
    crop_top=max(0,(len(figure)-height+1)//2)
    rng=random.SystemRandom()
    out=[]
    for y in range(height):
        fy=y-oy+crop_top
        line=figure[fy] if 0<=fy<len(figure) else ''
        positions=[i for i,c in enumerate(line) if c!=' ']
        left=min(positions) if positions else None
        right=max(positions) if positions else None
        pieces=[]
        last_rgb=None
        for x in range(width):
            fx=x-ox
            char=line[fx] if 0<=fx<len(line) else ' '
            rgb=None
            if char!=' ':
                rgb=grad(fy/max(1,len(figure)-1)*.78+max(0,fx)/max(1,fw)*.22)
            elif not (left is not None and left-2<=fx<=right+2) and rng.random()<.064:
                char=rng.choice(['.','.','.','*'])
                rgb=FAINT
            if USE_COLOR and last_rgb!=rgb:
                pieces.append(color(rgb) if rgb else reset())
                last_rgb=rgb
            pieces.append(char)
        out.append(''.join(pieces)+(reset() if USE_COLOR else ''))
    return out

def compact_notice(pretty, cols):
    inside=min(79,max(26,cols-2))
    heading="─ Vesly Cloud Labs "
    header=p("╭"+heading+"─"*max(0,inside-len(heading))+"╮",LAV)
    bottom=p("╰"+"─"*inside+"╯",LAV)
    def body(s):
        return p("│ ",LAV)+padded(s,inside-2)+p(" │",LAV)
    return [
        header,
        body(p(short(pretty,max(8,inside-27)),PINK)+p(" · Private Cloud",FAINT)),
        body(p("security@vesly.dev",PINK)),
        bottom,
    ]


def compact_main():
    cols,terminal_rows=shutil.get_terminal_size(fallback=(140,30))
    if sys.stdout.isatty() and not opts.no_clear:
        sys.stdout.write("\033[2J\033[H")
    # Prefer full-resolution art when there is enough horizontal room,
    # regardless of whether the SSH terminal reports only 24 rows.
    if cols>=99:
        art_mode,art_width="half",min(62,cols-54)
    elif cols>=75:
        art_mode,art_width="braille",31
    else:
        art_mode,art_width=None,0
    gap=2
    right_width=cols-art_width-gap if art_mode else cols
    text,pretty=compact_info(min(52,right_width))
    banner=compact_notice(pretty,cols)
    output=list(banner)
    if art_mode:
        full_art_height=(len(LOGO)+1)//2 if art_mode=="half" else (len(LOGO)+3)//4
        height=max(len(text), min(full_art_height, max(1,terminal_rows-5)))
        art=compressed_logo(art_mode,art_width,height)
        for i in range(height):
            left=art[i] if i<len(art) else ""
            right=text[i] if i<len(text) else ""
            output.append(padded(left,art_width)+" "*gap+right)
    else:
        output+=text
    sys.stdout.write("\n".join(output)+"\n")


def username_host():
    return getpass.getuser()+"@"+socket.gethostname()


if __name__=="__main__":
    try: main() if opts.full else compact_main()
    except BrokenPipeError: pass

