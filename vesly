def decode_pixels(code, count):
    import base64,zlib
    raw=zlib.decompress(base64.b85decode(code))
    assert len(raw)==count, 'Invalid Vesly logo data'
    return raw
def to_braille(code, cols, rows):
    data=decode_pixels(code,cols*rows*8)
    dots=((0,0,1),(0,1,2),(0,2,4),(0,3,64),
          (1,0,8),(1,1,16),(1,2,32),(1,3,128))
    result=[]
    for y in range(rows):
        row=[]
        for x in range(cols):
            m=0
            for dx,dy,bit in dots:
                if data[((y*4+dy)*cols*2)+(x*2+dx)]:
                    m|=bit
            row.append(chr(0x2800+m) if m else ' ')
        result.append(''.join(row))
    return result
def to_full_logo():
