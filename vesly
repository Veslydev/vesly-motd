A = argparse.ArgumentParser(description="Vesly Cloud Labs terminal welcome")
A.add_argument("--no-clear", action="store_true")
A.add_argument("--plain", action="store_true")
A.add_argument("--color", action="store_true")
A.add_argument("--full", action="store_true", help="show the original, uncompressed logo and full statistics")
opts = A.parse_args()
USE_COLOR = (sys.stdout.isatty() or opts.color) and not opts.plain and "NO_COLOR" not in os.environ
PURPLE_DARK=(125,66,246)     # #7D42F6
PURPLE_LIGHT=(209,156,255)  # #D19CFF
CYAN=PURPLE_LIGHT
LAV=(170,112,250)
PINK=PURPLE_LIGHT
